---
import type { GroupSummary } from "../lib/db";
interface Props {
  group: GroupSummary;
  index?: number;
}
const { group, index = 0 } = Astro.props;
---

<article class:list={["group-card", `accent-${index % 4}`]}>
  <header>
    <span class="room-monogram">
      {group.courseCode.replace(/\s/g, "").slice(0, 2)}
    </span>
    <span class:list={["visibility-badge", group.visibility]}>
      <i
        data-lucide={group.visibility === "public" ? "globe-2" : "lock-keyhole"}
        aria-hidden="true"
      ></i>
      {group.visibility === "public" ? "Public" : "Invite only"}
    </span>
  </header>
  {group.isExample && (
    <p class="example-label">Example room · curated starter discussions</p>
  )}
  <div class="group-card-main">
    <p class="card-kicker">
      {group.institution} · {group.courseCode}
    </p>
    <h3>
      <a href={`/groups/${group.id}`}>{group.name}</a>
    </h3>
    <p>{group.description}</p>
  </div>
  <footer>
    <div class="room-metrics">
      <span>
        <i data-lucide="users" aria-hidden="true"></i>
        {group.memberCount}
      </span>
      <span>
        <i data-lucide="message-circle" aria-hidden="true"></i>
        {group.questionCount}{" "}
        {group.questionCount === 1 ? "question" : "questions"}
      </span>
    </div>
    {group.isMember ? (
      <a
        class="card-open icon-button"
        href={`/groups/${group.id}`}
        aria-label={`Open ${group.name}`}
        data-tooltip="Open room"
      >
        <i data-lucide="arrow-up-right" aria-hidden="true"></i>
      </a>
    ) : (
      <form method="post" action="/api/groups/join">
        <input type="hidden" name="groupId" value={group.id} />
        <button class="small-button" type="submit">
          Join<i data-lucide="plus" aria-hidden="true"></i>
        </button>
      </form>
    )}
  </footer>
</article>
