---
interface Props {
  groupId: number;
  mode: "group" | "question" | "commons" | "search";
  questionId?: number;
}

const { groupId, mode, questionId } = Astro.props;
const regions =
  mode === "search"
    ? ""
    : mode === "commons"
      ? "[data-room-grid]|[data-room-total]|[data-public-room-grid]|[data-open-threads]"
      : mode === "group"
        ? "[data-group-stats]|[data-question-total]|[data-question-feed-content]|[data-invite-state]"
        : "[data-question-summary]|[data-answer-shared-total]|[data-answers-title]|[data-answer-list]|[data-question-member-count]";
---

<section
  class:list={[
    "realtime-panel",
    {
      compact: mode === "question",
      "commons-realtime": mode === "commons" || mode === "search",
    },
  ]}
  data-realtime
  data-stream-url={
    mode === "commons" || mode === "search"
      ? "/api/events"
      : `/api/groups/${groupId}/events`
  }
  data-realtime-mode={mode}
  data-question-id={questionId}
  data-live-regions={regions}
  aria-label="Live collaboration"
>
  <div class="live-connection">
    <span class="live-dot" data-live-dot aria-hidden="true"></span>
    <span>
      <strong data-live-label>Connecting</strong>
      <small>Updates arrive without reloading</small>
    </span>
  </div>
  <p class="live-presence">
    <strong data-presence-count>—</strong>{" "}
    <span data-presence-word>learners</span> here now
  </p>
  <p class="live-privacy">
    Presence is counted, never named. Drafts stay on this device.
  </p>
  <span
    class="sr-only"
    role="status"
    aria-live="polite"
    data-live-announcer
  ></span>
</section>

<script>
  interface LivePayload {
    groupId: number;
    questionId?: number;
    activeLearners?: number;
  }

  document.querySelectorAll<HTMLElement>("[data-realtime]").forEach((root) => {
    const streamUrl = root.dataset.streamUrl;
    const mode = root.dataset.realtimeMode;
    const questionId = Number(root.dataset.questionId);
    const selectors =
      root.dataset.liveRegions?.split("|").filter(Boolean) ?? [];
    const label = root.querySelector<HTMLElement>("[data-live-label]");
    const dot = root.querySelector<HTMLElement>("[data-live-dot]");
    const count = root.querySelector<HTMLElement>("[data-presence-count]");
    const presenceWord = root.querySelector<HTMLElement>(
      "[data-presence-word]",
    );
    const announcer = root.querySelector<HTMLElement>("[data-live-announcer]");
    if (!streamUrl || !label || !dot || !count || !presenceWord || !announcer)
      return;

    const source = new EventSource(streamUrl);
    let syncing = false;
    let syncRequested = false;

    const setConnection = (state: "live" | "reconnecting") => {
      root.dataset.connection = state;
      label.textContent = state === "live" ? "Live" : "Reconnecting";
    };

    const announce = (message: string) => {
      announcer.textContent = "";
      window.setTimeout(() => {
        announcer.textContent = message;
      }, 20);
    };

    const refreshOnce = async () => {
      if (selectors.length === 0) return;
      const response = await fetch(window.location.href, {
        cache: "no-store",
        headers: { "x-studynow-sync": "partial" },
      });
      if (!response.ok) throw new Error(`Sync failed with ${response.status}`);
      const nextDocument = new DOMParser().parseFromString(
        await response.text(),
        "text/html",
      );
      for (const selector of selectors) {
        const current = document.querySelector(selector);
        const next = nextDocument.querySelector(selector);
        if (current && next) current.replaceWith(next);
      }
      document.dispatchEvent(new Event("studynow:updated"));
      if (source.readyState === EventSource.OPEN) setConnection("live");
    };

    const syncRegions = async () => {
      syncRequested = true;
      if (syncing) return;
      syncing = true;
      try {
        while (syncRequested) {
          syncRequested = false;
          await refreshOnce();
        }
      } catch {
        setConnection("reconnecting");
        announce(
          "Live update was delayed. Reconnecting will restore the latest discussion.",
        );
        window.setTimeout(() => {
          if (source.readyState !== EventSource.CLOSED) void syncRegions();
        }, 1500);
      } finally {
        syncing = false;
      }
    };

    const payload = (event: Event): LivePayload =>
      JSON.parse((event as MessageEvent<string>).data) as LivePayload;

    source.addEventListener("open", () => setConnection("live"));
    source.addEventListener("error", () => setConnection("reconnecting"));
    source.addEventListener("ready", () => {
      void syncRegions();
      if (mode === "search")
        document.dispatchEvent(new Event("studynow:commons"));
    });
    source.addEventListener("presence.changed", (event) => {
      const activeLearners = payload(event).activeLearners ?? 0;
      count.textContent = String(activeLearners);
      presenceWord.textContent = activeLearners === 1 ? "learner" : "learners";
    });
    source.addEventListener("question.created", () => {
      if (mode !== "group") return;
      void syncRegions();
      announce("A new question joined this group.");
    });
    source.addEventListener("answer.created", (event) => {
      const update = payload(event);
      if (mode === "group" || update.questionId === questionId) {
        void syncRegions();
        announce("A new explanation arrived.");
      }
    });
    source.addEventListener("group.changed", () => {
      void syncRegions();
    });
    source.addEventListener("question.updated", () => {
      void syncRegions();
      announce("Question status updated.");
    });
    source.addEventListener("commons.changed", () => {
      void syncRegions();
      if (mode === "search")
        document.dispatchEvent(new Event("studynow:commons"));
    });

    window.addEventListener("pagehide", () => source.close(), { once: true });
  });
</script>
